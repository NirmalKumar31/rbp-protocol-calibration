# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored because the billing account ID identifies your account.
#
# Find your billing account with:
#   gcloud billing accounts list

billing_account = "XXXXXX-XXXXXX-XXXXXX"
project_id      = "rbp-repro-2026"         # globally unique, and MUST equal config/params.yaml
budget_usd      = 100
